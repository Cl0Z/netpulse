# =============================================================================
# NetPulse – Root .gitignore
# =============================================================================


# -----------------------------------------------------------------------------
# Environment / Secrets  (NEVER commit these)
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env

# -----------------------------------------------------------------------------
# Python – Agent & Backend
# -----------------------------------------------------------------------------

# Virtual environments
.venv/
venv/
env/
ENV/

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# -----------------------------------------------------------------------------
# Node / Frontend
# -----------------------------------------------------------------------------

node_modules/
dist/
.vite/

# Logs generated by Vite / npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript incremental build info
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Runtime / Process files  (created by start.sh / stop.sh)
# -----------------------------------------------------------------------------
*.pid
*.log
agent.log
frontend.log
backend.log

# -----------------------------------------------------------------------------
# OS & Editor artifacts
# -----------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# JetBrains IDEs
.idea/

# VSCode
.vscode/
*.code-workspace

# Vim / Neovim swap files
*.swp
*.swo
*.un~

# -----------------------------------------------------------------------------
# Docker / Database
# -----------------------------------------------------------------------------

# Docker volumes / data dumped locally
postgres_data/
*.sql.gz

# Compose file contains hardcoded credentials — keep local only
database/compose.yml
